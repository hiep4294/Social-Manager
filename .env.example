PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=replace-this-with-another-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# true = simulate Facebook/Instagram publishing without calling Meta APIs.
# Use only for development and CI. Keep false for live posting.
DEMO_MODE=false

# Direct ChatGPT / MCP control.
MCP_PORT=3001
MCP_HOST=0.0.0.0
MCP_API_TOKEN=replace-this-with-a-long-random-mcp-token
MCP_ALLOW_UNAUTHENTICATED=false
# Optional. Leave blank to use data/social-manager.db.
SOCIAL_MANAGER_DB=

# GitHub command bridge used while testing in Codespaces.
# Supports post_facebook, comment_facebook_page, reply_facebook_comment,
# facebook_operator, generated images, schedules and idempotency.
GITHUB_BRIDGE_ENABLED=false
GITHUB_BRIDGE_COMMAND_URL=https://raw.githubusercontent.com/hiep4294/Social-Manager/main/bridge/facebook-command.json
GITHUB_BRIDGE_POLL_MS=5000

# Safe Page comment auto reply. LOW risk is replied automatically;
# MEDIUM/HIGH is stored in community_inbox for review.
PAGE_AUTO_REPLY_ENABLED=false
PAGE_AUTO_REPLY_MODE=safe
PAGE_AUTO_REPLY_POLL_MS=60000
PAGE_AUTO_REPLY_POST_LIMIT=12
PAGE_AUTO_REPLY_COMMENT_LIMIT=50

# Browser operator for actions that Meta does not expose through Graph API.
# It never automates login, CAPTCHA, 2FA or security checkpoints.
FB_OPERATOR_ENABLED=false
FB_OPERATOR_HEADLESS=true
FB_OPERATOR_BROWSER_PATH=
FB_OPERATOR_PROFILE_DIR=
FB_OPERATOR_LOCALE=vi-VN
FB_OPERATOR_POLL_MS=10000
FB_OPERATOR_MIN_DELAY_MS=8000

# Codespaces self update. Code releases must bump package.json and
# bridge/runtime-version.json to the same version.
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/hiep4294/Social-Manager/main/bridge/runtime-version.json
AUTO_UPDATE_CHECK_MS=60000

META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_CONFIG_ID=
# Page publishing + Page engagement. Reconnect the Page after adding new scopes.
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_engagement,pages_read_user_content

# Legacy fallback only. OAuth connections stored in the database are preferred.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
