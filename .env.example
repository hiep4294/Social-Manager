PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-string
TOKEN_ENCRYPTION_KEY=replace-this-with-another-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# true = simulate Facebook/Instagram publishing without calling Meta APIs.
# Use only for development and CI. Keep false for live posting.
DEMO_MODE=false

# Direct ChatGPT / MCP control.
MCP_PORT=3001
MCP_HOST=0.0.0.0
MCP_API_TOKEN=replace-this-with-a-long-random-mcp-token
MCP_ALLOW_UNAUTHENTICATED=false
SOCIAL_MANAGER_DB=

# GitHub bridge for official Page actions.
GITHUB_BRIDGE_ENABLED=false
GITHUB_BRIDGE_COMMAND_URL=https://raw.githubusercontent.com/hiep4294/Social-Manager/main/bridge/facebook-command.json
GITHUB_BRIDGE_POLL_MS=5000

# Safe Page comment auto reply via official Graph API.
# LOW risk is replied automatically; MEDIUM/HIGH is kept for review.
PAGE_AUTO_REPLY_ENABLED=false
PAGE_AUTO_REPLY_MODE=safe
PAGE_AUTO_REPLY_POLL_MS=60000
PAGE_AUTO_REPLY_POST_LIMIT=12
PAGE_AUTO_REPLY_COMMENT_LIMIT=50

# Browser operator for actions that Meta does not expose through Graph API.
# It never automates login, CAPTCHA, 2FA or security checkpoints.
FB_OPERATOR_ENABLED=false
FB_OPERATOR_HEADLESS=false
FB_OPERATOR_BROWSER_PATH=
FB_OPERATOR_PROFILE_DIR=
FB_OPERATOR_LOCALE=vi-VN
FB_OPERATOR_POLL_MS=10000
FB_OPERATOR_MIN_DELAY_MS=8000

# V1.7 remote operator queue. Commands must include id, issued_at and expires_at.
# Legacy single-command polling is disabled by default to prevent replay on a fresh DB.
FB_OPERATOR_COMMAND_POLL_ENABLED=false
FB_OPERATOR_COMMAND_POLL_MS=5000
FB_OPERATOR_COMMAND_QUEUE_URL=https://raw.githubusercontent.com/hiep4294/Social-Manager/main/bridge/operator-queue.json
FB_OPERATOR_ALLOW_LEGACY_COMMAND=false
FB_OPERATOR_LEGACY_COMMAND_URL=https://raw.githubusercontent.com/hiep4294/Social-Manager/main/bridge/facebook-command.json
FB_OPERATOR_COMMAND_MAX_AGE_MS=900000
FB_OPERATOR_COMMAND_FUTURE_SKEW_MS=120000
FB_OPERATOR_COMMAND_QUEUE_MAX=100

# Safety guard. Group actions require a remembered/approved Group first.
FB_AGENT_REQUIRE_KNOWN_GROUP=true
FB_AGENT_RATE_POST_GROUP_PER_HOUR=8
FB_AGENT_RATE_COMMENT_GROUP_PER_HOUR=20
FB_AGENT_RATE_LIKE_GROUP_POST_PER_HOUR=30
FB_AGENT_RATE_LIKE_FIRST_GROUP_POST_PER_HOUR=30
FB_AGENT_RATE_LIKE_GROUP_COMMENTS_PER_HOUR=12

# Reliability: heartbeat, stale PROCESSING recovery and rolling SQLite backup.
FB_OPERATOR_RELIABILITY_ENABLED=true
FB_OPERATOR_HEARTBEAT_MS=15000
FB_OPERATOR_JOB_LEASE_MS=600000
FB_OPERATOR_MAX_ATTEMPTS=3
FB_OPERATOR_BACKUP_MS=86400000
FB_OPERATOR_BACKUP_KEEP=7

# V1.9.1 bounded self-healing.
# Only transient transport/browser failures are retried automatically.
# UI changes, permissions, login, CAPTCHA, 2FA and checkpoints remain manual/review states.
OPERATOR_SELF_HEALING_ENABLED=true
OPERATOR_SELF_HEALING_TICK_MS=30000
OPERATOR_SELF_HEALING_MAX_ATTEMPTS=3
OPERATOR_SELF_HEALING_BASE_DELAY_MS=60000
OPERATOR_SELF_HEALING_MAX_DELAY_MS=1800000
OPERATOR_TEMP_MAX_AGE_MS=21600000

# Windows Facebook Operator Agent self update + auto-start.
# Auto update follows the stable branch, not every development commit on main.
# Auto-start prefers Task Scheduler; if unavailable it falls back to HKCU Run.
# A watchdog restarts the Supervisor if it exits unexpectedly.
FB_AGENT_AUTO_UPDATE=true
FB_AGENT_AUTO_UPDATE_MS=60000
FB_AGENT_UPDATE_REPOSITORY=hiep4294/Social-Manager
FB_AGENT_UPDATE_BRANCH=stable
FB_AGENT_AUTOSTART=true
FB_AGENT_WATCHDOG_RESTART_MS=5000

# V1.9 automatic Food Network.
# 24 Pages/year, one post/day/active Page.
# Daily publishing is spread across a window to avoid posting all Pages at once.
# Dish images are selected from suitably licensed Wikimedia Commons media and attribution is appended.
# CAPTCHA/2FA/checkpoint or an unrecognized Facebook UI stops the affected Page for review.
FOOD_NETWORK_AUTO_ENABLED=true
FOOD_NETWORK_START_DATE=
FOOD_NETWORK_TICK_MS=60000
FOOD_NETWORK_POST_WINDOW_START_MINUTE=660
FOOD_NETWORK_POST_WINDOW_MINUTES=540
FOOD_NETWORK_PAGE_CATEGORY=Food & beverage

# V1.7 Group Monitor.
# New monitors default to 600 seconds (10 minutes).
# The application clamps each monitor to a minimum of 300 seconds (5 minutes).
# Recommended: poll_seconds=300 for important groups, 600 for normal groups.
GROUP_MONITOR_ENABLED=false
GROUP_MONITOR_SCHEDULER_MS=60000
GROUP_MONITOR_MAX_REPLIES_PER_SCAN=2
GROUP_MONITOR_REPLY_DELAY_MS=8000

# Codespaces self update. Code releases must bump package.json and
# bridge/runtime-version.json to the same version.
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/hiep4294/Social-Manager/main/bridge/runtime-version.json
AUTO_UPDATE_CHECK_MS=60000

META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_CONFIG_ID=
# Page publishing + Page engagement. Reconnect the Page after adding new scopes.
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_engagement,pages_read_user_content

# Legacy fallback only. OAuth connections stored in the database are preferred.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=