{
  "manifest_version": 3,
  "name": "Social Manager Operator",
  "version": "2.1.0",
  "description": "Social Manager browser operator: Facebook automation and ChatGPT generated-image capture to the food library.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:3210/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://web.facebook.com/*",
    "https://upload.wikimedia.org/*",
    "https://commons.wikimedia.org/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.app.github.dev/*",
    "https://*.io.vn/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "content-facebook.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content-chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.app.github.dev/*",
        "https://*.io.vn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content-social-manager.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Social Manager"
  }
}
